;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="BlackSaturn"
run/main_scene="res://Levels/test_level.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

DStates="*res://Global_Const/Darkest_States.gd"
DGroups="*res://Global_Const/Darkest_Groups.gd"
DDebug="*res://Global_Const/Darkest_Debug.gd"
DDirection="*res://Global_Const/Darkest_Direction.gd"

[display]

window/size/viewport_width=512
window/size/viewport_height=480
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="BlackSaturn"

[global_group]

ladders=""
EnemyBullet=""
volatile="attacks that disappear on contact"
CameraTriggers=""
Dodge=""
Player=""
CameraFollowX=""
CameraFollowY=""

